# LangSmith 추적 설정 — 실제 값은 .env에 넣는다 (.env는 git에 커밋하지 않음)
# 추적은 필요할 때 별도 설정한다. 기본 실행은 외부 추적을 사용하지 않는다.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=capstone-all-total
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LLM_BACKEND=openai 모드(run_openai.sh)에서만 필요 — 실제 OpenAI 계정에 과금되는
# 원격 API 키다. 절대 커밋하지 말고, 본인 계정의 유효한 키를 .env에만 넣을 것.
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# 실제 API 실행: bash sh/run_agent_openai.sh
LLM_BACKEND=openai
RUNBOOK_EMBEDDING_BACKEND=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
RUNBOOK_RERANK_ENABLED=true
# 다른 DB에서 테스트하거나 실행하려면 절대 경로를 지정한다. 미설정 시 session.db.
# SESSION_DB_PATH=/absolute/path/test_session.db
# OPENAI_RERANK_MODEL=gpt-4o-mini
# 인덱스 생성: .venv/bin/python sh/build_runbook_index.py
# RUNBOOK_INDEX_PATH=/absolute/path/runbook_index.json
# RUNBOOK_SCORE_THRESHOLD=0.42
# RUNBOOK_SCORE_GAP=0.06
